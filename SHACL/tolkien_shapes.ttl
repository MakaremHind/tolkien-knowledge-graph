@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix ex: <http://example.org/tolkien/ontology#> .

#################################################################
# Fictional Characters (represented as schema:Person)
#################################################################

ex:FictionalCharacterShape
    a sh:NodeShape ;

    sh:targetSubjectsOf schema:species ;
    sh:targetClass ex:FictionalCharacter ;

    sh:property [
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path schema:species ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "A fictional character must have a species."@en ;
    ] ;

    sh:property [
        sh:path schema:gender ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path schema:location ;
        sh:datatype xsd:string ;
    ] .



#################################################################
# Real-world Persons (actors, authors, scholars)
#################################################################

ex:RealPersonShape
    a sh:NodeShape ;

    sh:targetClass schema:Person ;
    sh:targetClass ex:RealPerson ;

    sh:property [
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path schema:jobTitle ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path schema:birthDate ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

#################################################################
# Literary Works (Books)
#################################################################

ex:LiteraryWorkShape
    a sh:NodeShape ;

    sh:targetClass schema:Book ;
    sh:targetClass ex:LiteraryWork ;

    sh:property [
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path schema:author ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path schema:datePublished ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path schema:numberOfPages ;
        sh:datatype xsd:string ;
    ] .


#################################################################
# Film Adaptations
#################################################################

ex:FilmAdaptationShape
    a sh:NodeShape ;

    sh:targetClass schema:Movie ;
    sh:targetClass ex:FilmAdaptation ;

    sh:property [
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path schema:director ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path schema:datePublished ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path schema:budget ;
        sh:datatype xsd:string ;
    ] .


#################################################################
# Organizations (in-universe or real)
#################################################################

ex:OrganizationInUniverseShape
    a sh:NodeShape ;

    sh:targetClass schema:Organization ;
    sh:targetClass ex:OrganizationInUniverse ;

    sh:property [
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path schema:alternateName ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path schema:foundingDate ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path schema:dissolutionDate ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path schema:description ;
        sh:datatype xsd:string ;
    ] .


#################################################################
# Conceptual Resources (abstract Tolkien concepts)
#################################################################

ex:ConceptResourceShape
    a sh:NodeShape ;

    sh:targetClass schema:Thing ;
    sh:targetClass ex:ConceptResource ;

    sh:property [
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path schema:description ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path schema:sameAs ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
    ] .

