@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix ex: <http://example.org/tolkien/ontology#> .


ex:FictionalCharacterShape
    a sh:NodeShape ;
    sh:targetClass ex:FictionalCharacter ;

    sh:property [
        sh:path ex:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A fictional character must have exactly one name."@en ;
    ] ;

    sh:property [
        sh:path ex:gender ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "Gender must be a string."@en ;
    ] ;

    sh:property [
        sh:path ex:species ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Species is required for fictional characters."@en ;
    ] ;

    sh:property [
        sh:path ex:location ;
        sh:datatype xsd:string ;
        sh:message "Location must be a string."@en ;
    ] .

ex:RealPersonShape
    a sh:NodeShape ;
    sh:targetClass ex:RealPerson ;

    sh:property [
        sh:path ex:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path ex:birthDate ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "Birth date should be provided as a literal string."@en ;
    ] ;

    sh:property [
        sh:path ex:gender ;
        sh:datatype xsd:string ;
    ] .

ex:LiteraryWorkShape
    a sh:NodeShape ;
    sh:targetClass ex:LiteraryWork ;

    sh:property [
        sh:path ex:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path ex:publicationDate ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path ex:language ;
        sh:datatype xsd:string ;
    ] .

ex:FilmAdaptationShape
    a sh:NodeShape ;
    sh:targetClass ex:FilmAdaptation ;

    sh:property [
        sh:path ex:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path ex:budget ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path ex:publicationDate ;
        sh:datatype xsd:string ;
    ] .

ex:OrganizationInUniverseShape
    a sh:NodeShape ;
    sh:targetClass ex:OrganizationInUniverse ;

    sh:property [
        sh:path ex:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path ex:description ;
        sh:datatype xsd:string ;
    ] .
