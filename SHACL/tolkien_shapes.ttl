@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix ex: <http://example.org/tolkien/ontology#> .


ex:FictionalCharacterShape
    a sh:NodeShape ;
    sh:targetClass ex:FictionalCharacter ;

    sh:property [
        sh:path ex:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A fictional character must have exactly one name."@en ;
    ] ;

    sh:property [
        sh:path ex:gender ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "Gender must be a string."@en ;
    ] ;

    sh:property [
        sh:path ex:species ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Species is required for fictional characters."@en ;
    ] ;

    sh:property [
        sh:path ex:location ;
        sh:datatype xsd:string ;
        sh:message "Location must be a string."@en ;
    ] .

ex:RealPersonShape
    a sh:NodeShape ;
    sh:targetClass ex:RealPerson ;

    sh:property [
        sh:path ex:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path ex:birthDate ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "Birth date should be provided as a literal string."@en ;
    ] ;

    sh:property [
        sh:path ex:gender ;
        sh:datatype xsd:string ;
    ] .

ex:LiteraryWorkShape
    a sh:NodeShape ;
    sh:targetClass ex:LiteraryWork ;

    sh:property [
        sh:path ex:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path ex:publicationDate ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path ex:language ;
        sh:datatype xsd:string ;
    ] .

ex:FilmAdaptationShape
    a sh:NodeShape ;
    sh:targetClass ex:FilmAdaptation ;

    sh:property [
        sh:path ex:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path ex:budget ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:path ex:publicationDate ;
        sh:datatype xsd:string ;
    ] .

ex:OrganizationInUniverseShape
    a sh:NodeShape ;
    sh:targetClass ex:OrganizationInUniverse ;

    sh:property [
        sh:path ex:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path ex:description ;
        sh:datatype xsd:string ;
    ] .

ex:WikiPageShape
    a sh:NodeShape ;
    sh:targetClass ex:WikiPage ;

    sh:property [
        sh:path ex:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path ex:about ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "A WikiPage must be about exactly one resource."@en ;
    ] .

ex:PlaceInMiddleEarthShape
    a sh:NodeShape ;
    sh:targetClass ex:PlaceInMiddleEarth ;

    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:description "Human-readable name of the place"@en ;
    ] ;

    sh:property [
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:description "Canonical name of the place"@en ;
    ] ;

    sh:property [
        sh:path schema:location ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:description "Geographical or fictional location context"@en ;
    ] ;

    sh:property [
        sh:path schema:containedInPlace ;
        sh:class ex:PlaceInMiddleEarth ;
        sh:minCount 0 ;
        sh:description "Larger region containing this place"@en ;
    ] ;

    sh:property [
        sh:path schema:sameAs ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:description "Link to corresponding Tolkien Gateway page"@en ;
    ] .

